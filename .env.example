# ============================================================
# Multimodal Video Summarizer — Environment Configuration
# ============================================================

# (Optional) Google Gemini API Key — Used for Presentation (PPT) and Flashcards generation
# Free tier available at: https://aistudio.google.com/app/apikey (15 requests/min free)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
XAI_API_KEY=your_xai_api_key_here

# (Optional) xAI Grok API Key — Used for Interactive Quiz generation
# Console: https://console.x.ai/

GROK_API_KEY=

# NOTE: If keys are left blank, the platform automatically and seamlessly
# uses your local Apple Silicon (MPS) / CPU Qwen2.5 engine as a free fallback.
# Configure API keys below or in your system environment.
